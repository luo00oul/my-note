{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\ud83d\udc4b \u6b22\u8fce\u6765\u5230 luo00oul \u7684\u7b14\u8bb0","text":"<p>\u5173\u4e8e\u672c\u7ad9</p> <p>\u8fd9\u91cc\u662f\u6211\u5728 \u6e56\u5357\u5927\u5b66 \u00b7 \u8ba1\u7b97\u673a\u79d1\u5b66 \u5b66\u4e60\u8fc7\u7a0b\u4e2d\u7684 \ud83d\udcd8 \u6570\u5b66\u7b14\u8bb0 | \ud83d\udcbb \u7f16\u7a0b\u8bb0\u5f55 | \ud83e\udde0 \u601d\u8003\u603b\u7ed3  </p> <p>\u6301\u7eed\u66f4\u65b0\u4e2d\uff0c\u76ee\u6807\u662f\uff1a\u5199\u7ed9\u672a\u6765\u7684\u81ea\u5df1\u770b</p>"},{"location":"#_1","title":"\ud83d\udccc \u5b66\u4e60\u65b9\u5411\u4e00\u89c8","text":"<p>\ud83d\udcd0 \u6570\u5b66</p> <ul> <li>\u7ebf\u6027\u4ee3\u6570\uff08\u77e9\u9635 / \u7279\u5f81\u503c / \u6b63\u4ea4\u5316\uff09</li> <li>\u6570\u5b66\u516c\u5f0f\u7edf\u4e00\u7528 LaTeX \u8868\u793a  </li> </ul> <p>\ud83d\udcbb \u8ba1\u7b97\u673a</p> <ul> <li>\u6570\u636e\u7ed3\u6784 &amp; \u7b97\u6cd5</li> <li>Python / C / \u9762\u5411\u5bf9\u8c61</li> </ul> <p>\ud83d\udee0 \u5de5\u5177</p> <ul> <li>Git / GitHub</li> <li>LaTeX</li> <li>MkDocs + GitHub Pages</li> </ul>"},{"location":"#_2","title":"\ud83d\udd17 \u5feb\u901f\u5165\u53e3","text":"<ul> <li>\ud83d\udc49 \u7ebf\u6027\u4ee3\u6570</li> <li>\ud83d\udc49 \u6570\u636e\u7ed3\u6784</li> <li>\ud83d\udc49 Python</li> <li>\ud83d\udc49 LaTeX</li> </ul> <p>\ud83d\udcc5 \u6700\u8fd1\u66f4\u65b0\uff1a\u6301\u7eed\u7ef4\u62a4\u4e2d \u2b50 GitHub\uff1a\u53f3\u4e0a\u89d2\u53ef\u76f4\u63a5\u67e5\u770b\u6e90\u7801</p>"},{"location":"LaTeX/","title":"LaTeX","text":"<p>\u597d\u95ee\u9898\uff0c\u800c\u4e1414 \u5929 + \u6bcf\u5929 1\uff5e2 \u5c0f\u65f6\u8fd9\u4e2a\u76ee\u6807\u662f\u5b8c\u5168\u53ef\u884c\u7684 \ud83d\udc4d \u300a\u4e00\u4efd\u4e0d\u592a\u7b80\u5355\u7684 LaTeX \u6307\u5357\u300b\u672c\u8eab\u5c31\u975e\u5e38\u9002\u5408\u4f60\u8fd9\u79cd CS + \u6570\u5b66 + \u7b14\u8bb0\u6392\u7248 \u7684\u9700\u6c42\u3002</p> <p>\u6211\u4f1a\u7ed9\u4f60\u4e09\u6837\u4e1c\u897f\uff1a 1\ufe0f\u20e3 \u603b\u4f53\u5b66\u4e60\u5efa\u8bae\uff08\u907f\u5751 + \u65b9\u6cd5\u8bba\uff09 2\ufe0f\u20e3 14 \u5929\u8be6\u7ec6\u5b66\u4e60\u8ba1\u5212\uff08\u6bcf\u5929 1\uff5e2h\uff0c\u53ef\u6267\u884c\uff09 3\ufe0f\u20e3 \u201c14 \u5929\u540e\u4f60\u5e94\u8be5\u80fd\u505a\u5230\u4ec0\u4e48\u201d\u7684\u9a8c\u6536\u6807\u51c6</p> <p>\u6574\u4f53\u98ce\u683c\uff1a\u7a33\u8fdb\u9636\u3001\u4e0d\u6298\u817e\u3001\u4ee5\u5199\u7b14\u8bb0\u4e3a\u6838\u5fc3 \u270d\ufe0f\ud83d\udcd0</p>"},{"location":"LaTeX/#_1","title":"\u4e00\u3001\u5148\u8bf4\u7ed3\u8bba\uff1a\u4f60\u8be5\u600e\u4e48\u5b66\uff08\u5f88\u91cd\u8981\uff09","text":""},{"location":"LaTeX/#_2","title":"\u2705 \u6b63\u786e\u5b66\u4e60\u59ff\u52bf\uff08\u975e\u5e38\u5173\u952e\uff09","text":"<p>LaTeX \u2260 \u7f16\u7a0b\u8bed\u8a00 \ud83d\udc49 \u5b83\u662f\u201c\u6807\u8bb0\u8bed\u8a00 + \u6392\u7248\u7cfb\u7edf\u201d\uff0c\u6240\u4ee5\uff1a</p> <ul> <li>\u274c \u4e0d\u8981\u6b7b\u8bb0\u547d\u4ee4</li> <li>\u2705 \u8981\u8fb9\u770b\u8fb9\u6572\u3001\u8fb9\u6539\u8fb9\u770b\u6548\u679c</li> <li>\u2705 \u4ee5\u201c\u6211\u8981\u5199\u4e00\u4efd\u7b14\u8bb0\u201d\u4e3a\u9a71\u52a8</li> </ul>"},{"location":"LaTeX/#_3","title":"\u2705 \u5f3a\u70c8\u5efa\u8bae\u7684\u5de5\u5177\u7ec4\u5408","text":"<p>\u4efb\u9009\u4e00\u4e2a\u5373\u53ef\uff1a</p> <ul> <li>Overleaf\uff08\u63a8\u8350\u65b0\u624b\uff09<ul> <li>\u4e0d\u7528\u88c5\u73af\u5883</li> <li>\u5b9e\u65f6\u9884\u89c8</li> </ul> </li> <li>\u6216 \u672c\u5730 TeX Live + VS Code + LaTeX Workshop<ul> <li>\u7b49\u7b2c 7\uff5e8 \u5929\u518d\u641e</li> </ul> </li> </ul> <p>\u524d 7 \u5929\uff1aOverleaf \u540e 7 \u5929\uff1a\u968f\u4f60\uff0cOverleaf \u4e5f\u5b8c\u5168\u591f\u7528</p>"},{"location":"LaTeX/#14-latex-12h","title":"\u4e8c\u300114 \u5929 LaTeX \u5165\u95e8\u5b9e\u6218\u8ba1\u5212\uff08\u6bcf\u5929 1\uff5e2h\uff09","text":"<p>\u53c2\u8003\u4e66\uff1a\u300a\u4e00\u4efd\u4e0d\u592a\u7b80\u5355\u7684 LaTeX \u6307\u5357\u300b \u6838\u5fc3\u76ee\u6807\uff1a\u80fd\u5199\u6570\u5b66 + \u80fd\u6392\u7248\u7b14\u8bb0 + \u4e0d\u6015\u62a5\u9519</p>"},{"location":"LaTeX/#day-1latex","title":"\ud83d\udcc5 Day 1\uff1aLaTeX \u662f\u4ec0\u4e48 &amp; \u6700\u5c0f\u53ef\u7528\u6587\u6863\uff08\u8d85\u91cd\u8981\uff09","text":"<p>\u76ee\u6807\uff1a\u80fd\u6210\u529f\u7f16\u8bd1\u4e00\u4efd\u6700\u7b80\u5355\u7684\u6587\u6863</p> <p>\ud83d\udcd6 \u770b\uff1a</p> <ul> <li>\u4ec0\u4e48\u662f LaTeX</li> <li>\u6587\u6863\u7ed3\u6784\uff08documentclass / preamble / document\uff09</li> </ul> <p>\ud83e\udde0 \u91cd\u70b9\u638c\u63e1\uff1a</p> <pre><code>\\documentclass{article}\n\\begin{document}\nHello LaTeX!\n\\end{document}\n</code></pre> <p>\u270d\ufe0f \u5b9e\u8df5\uff1a</p> <ul> <li>\u6539\u6807\u9898</li> <li>\u52a0\u4e00\u6bb5\u4e2d\u6587\uff08\u7528 <code>ctexart</code>\uff09</li> </ul> <p>\u2705 \u4eca\u65e5\u4ea7\u51fa\uff1a</p> <ul> <li>\u4e00\u4efd\u80fd\u7f16\u8bd1\u7684\u4e2d\u6587 LaTeX \u6587\u4ef6</li> </ul>"},{"location":"LaTeX/#day-2","title":"\ud83d\udcc5 Day 2\uff1a\u57fa\u672c\u6587\u672c\u6392\u7248 &amp; \u4e2d\u6587\u73af\u5883","text":"<p>\u76ee\u6807\uff1a\u5199\u201c\u6b63\u5e38\u4eba\u7c7b\u80fd\u770b\u7684\u6587\u5b57\u201d</p> <p>\ud83d\udcd6 \u770b\uff1a</p> <ul> <li>\u6bb5\u843d\u3001\u6362\u884c</li> <li>\u52a0\u7c97\u3001\u659c\u4f53</li> <li>\u5217\u8868\uff08itemize / enumerate\uff09</li> </ul> <p>\ud83e\udde0 \u5fc5\u4f1a\uff1a</p> <pre><code>\\textbf{\u52a0\u7c97}\n\\emph{\u5f3a\u8c03}\n\\begin{itemize}\n  \\item \u7b2c\u4e00\u6761\n\\end{itemize}\n</code></pre> <p>\u270d\ufe0f \u5b9e\u8df5\uff1a</p> <ul> <li>\u5199\u4e00\u9875\u300c\u7ebf\u6027\u4ee3\u6570/\u6570\u636e\u7ed3\u6784\u300d\u7eaf\u6587\u5b57\u7b14\u8bb0</li> </ul>"},{"location":"LaTeX/#day-3","title":"\ud83d\udcc5 Day 3\uff1a\u6570\u5b66\u516c\u5f0f \u00b7 \u884c\u5185 &amp; \u884c\u95f4\uff08\u6838\u5fc3\uff09","text":"<p>\u76ee\u6807\uff1a\u4f1a\u5199 80% \u5e38\u89c1\u6570\u5b66\u516c\u5f0f</p> <p>\ud83d\udcd6 \u770b\uff1a</p> <ul> <li><code>$...$</code></li> <li><code>\\[...\\]</code></li> <li>\u4e0a\u4e0b\u6807\u3001\u5206\u6570\u3001\u6839\u53f7</li> </ul> <p>\ud83e\udde0 \u5fc5\u4f1a\uff1a</p> <pre><code>$a^2 + b^2 = c^2$\n\\[\n\\frac{a}{b}, \\sqrt{x}, \\sum_{i=1}^n\n\\]\n</code></pre> <p>\u270d\ufe0f \u5b9e\u8df5\uff1a</p> <ul> <li>\u628a\u4f60\u4e00\u672c\u6570\u5b66\u8bfe\u672c\u4e2d\u7684 5 \u4e2a\u516c\u5f0f\u6572\u8fdb\u53bb</li> </ul> <p>\ud83d\udd25 \u4eca\u5929\u975e\u5e38\u91cd\u8981</p>"},{"location":"LaTeX/#day-4","title":"\ud83d\udcc5 Day 4\uff1a\u5e38\u7528\u6570\u5b66\u7ed3\u6784\uff08\u77e9\u9635 / \u5206\u6bb5\u51fd\u6570\uff09","text":"<p>\u76ee\u6807\uff1a\u641e\u5b9a\u8003\u8bd5 + \u7b14\u8bb0\u4e2d\u6700\u70e6\u7684\u4e1c\u897f</p> <p>\ud83e\udde0 \u5fc5\u4f1a\uff1a</p> <pre><code>\\begin{matrix}\na &amp; b \\\\\nc &amp; d\n\\end{matrix}\nf(x)=\n\\begin{cases}\nx^2 &amp; x&gt;0 \\\\\n0 &amp; x\\le 0\n\\end{cases}\n</code></pre> <p>\u270d\ufe0f \u5b9e\u8df5\uff1a</p> <ul> <li>\u5199\u4e00\u4e2a\u201c\u77e9\u9635 + \u5206\u6bb5\u51fd\u6570 + \u63a8\u5bfc\u516c\u5f0f\u201d</li> </ul>"},{"location":"LaTeX/#day-5","title":"\ud83d\udcc5 Day 5\uff1a\u5b9a\u7406\u3001\u8bc1\u660e\u3001\u516c\u5f0f\u7f16\u53f7","text":"<p>\u76ee\u6807\uff1a\u50cf\u201c\u6b63\u5f0f\u7b14\u8bb0/\u8bb2\u4e49\u201d\u4e00\u6837\u6392\u7248</p> <p>\ud83d\udcd6 \u770b\uff1a</p> <ul> <li>theorem / proof</li> <li>equation \u7f16\u53f7\u4e0e\u5f15\u7528</li> </ul> <p>\ud83e\udde0 \u5fc5\u4f1a\uff1a</p> <pre><code>\\begin{theorem}\n...\n\\end{theorem}\n\\label{eq:1}\n\\ref{eq:1}\n</code></pre> <p>\u270d\ufe0f \u5b9e\u8df5\uff1a</p> <ul> <li>\u5199\u4e00\u4e2a\u201c\u5b9a\u7406 + \u8bc1\u660e + \u5f15\u7528\u516c\u5f0f\u201d</li> </ul>"},{"location":"LaTeX/#day-6","title":"\ud83d\udcc5 Day 6\uff1a\u63d2\u56fe\u3001\u8868\u683c\uff08\u5b9e\u7528\u4f46\u522b\u6df1\u6316\uff09","text":"<p>\u76ee\u6807\uff1a\u4f1a\u7528\uff0c\u4e0d\u7ea0\u7ed3</p> <p>\ud83e\udde0 \u4f1a\u8fd9\u4e9b\u5c31\u591f\u4e86\uff1a</p> <pre><code>\\begin{figure}\n\\includegraphics{xxx}\n\\end{figure}\n\\begin{tabular}{ccc}\na &amp; b &amp; c\n\\end{tabular}\n</code></pre> <p>\u270d\ufe0f \u5b9e\u8df5\uff1a</p> <ul> <li>\u63d2\u4e00\u5f20\u56fe</li> <li>\u5199\u4e00\u4e2a\u7b80\u5355\u8868\u683c</li> </ul>"},{"location":"LaTeX/#day-7","title":"\ud83d\udcc5 Day 7\uff1a\u7b2c\u4e00\u6b21\u6574\u5408\uff1a\u5199\u4e00\u4efd\u5b8c\u6574\u7b14\u8bb0","text":"<p>\ud83d\udd25 \u9636\u6bb5\u603b\u7ed3\u65e5</p> <p>\u270d\ufe0f \u4efb\u52a1\uff1a</p> <ul> <li>\u5199\u4e00\u4efd 2\uff5e3 \u9875\u7684 LaTeX \u6570\u5b66/CS \u7b14\u8bb0<ul> <li>\u6807\u9898</li> <li>\u6587\u5b57</li> <li>\u516c\u5f0f</li> <li>\u77e9\u9635</li> <li>\u5b9a\u7406</li> </ul> </li> </ul> <p>\ud83c\udfaf \u5230\u8fd9\u91cc\u4f60\u5df2\u7ecf \u8d85\u8fc7 70% \u65b0\u624b\u4e86</p>"},{"location":"LaTeX/#day-8","title":"\ud83d\udcc5 Day 8\uff1a\u5e38\u7528\u5b8f &amp; \u81ea\u5b9a\u4e49\u547d\u4ee4\uff08\u6548\u7387\u63d0\u5347\uff09","text":"<p>\u76ee\u6807\uff1a\u8ba9 LaTeX \u201c\u50cf\u4f60\u81ea\u5df1\u7684\u5de5\u5177\u201d</p> <p>\ud83e\udde0 \u5fc5\u4f1a\uff1a</p> <pre><code>\\newcommand{\\R}{\\mathbb{R}}\n</code></pre> <p>\u270d\ufe0f \u5b9e\u8df5\uff1a</p> <ul> <li>\u7ed9\u5e38\u7528\u7b26\u53f7\u505a 3\uff5e5 \u4e2a\u5b8f</li> </ul>"},{"location":"LaTeX/#day-9","title":"\ud83d\udcc5 Day 9\uff1a\u6570\u5b66\u7b26\u53f7\u5927\u5168 &amp; \u67e5\u8868\u80fd\u529b","text":"<p>\u76ee\u6807\uff1a\u4e0d\u4f1a\u7684\u4e1c\u897f\u77e5\u9053\u53bb\u54ea\u67e5</p> <p>\ud83d\udcd6 \u770b\uff1a</p> <ul> <li>\u5e38\u7528\u7b26\u53f7</li> <li>AMS \u5b8f\u5305</li> </ul> <p>\u270d\ufe0f \u5b9e\u8df5\uff1a</p> <ul> <li>\u6545\u610f\u5199 5 \u4e2a\u201c\u6ca1\u5b66\u8fc7\u7684\u7b26\u53f7\u201d\uff0c\u7136\u540e\u67e5\u51fa\u6765</li> </ul>"},{"location":"LaTeX/#day-10","title":"\ud83d\udcc5 Day 10\uff1a\u9519\u8bef\u5904\u7406 &amp; \u7f16\u8bd1\u601d\u7ef4","text":"<p>\u76ee\u6807\uff1a\u4e0d\u6015\u62a5\u9519</p> <p>\ud83e\udde0 \u91cd\u70b9\uff1a</p> <ul> <li>Missing $</li> <li>Environment ended by</li> <li>Undefined control sequence</li> </ul> <p>\u270d\ufe0f \u5b9e\u8df5\uff1a</p> <ul> <li>\u6545\u610f\u5236\u9020\u9519\u8bef</li> <li>\u770b log \u5b9a\u4f4d</li> </ul>"},{"location":"LaTeX/#day-11latex","title":"\ud83d\udcc5 Day 11\uff1aLaTeX \u6392\u7248\u4e60\u60ef\uff08\u50cf\u8001\u624b\uff09","text":"<p>\u76ee\u6807\uff1a\u5199\u5f97\u201c\u5e72\u51c0 + \u597d\u7ef4\u62a4\u201d</p> <ul> <li>\u7a7a\u884c \u2260 \u6362\u884c</li> <li>\u6e90\u7801\u5bf9\u9f50</li> <li>\u6ce8\u91ca <code>%</code></li> </ul> <p>\u270d\ufe0f \u91cd\u6784\u4f60 Day 7 \u7684\u6587\u6863</p>"},{"location":"LaTeX/#day-12","title":"\ud83d\udcc5 Day 12\uff1a\u6a21\u677f\u5316\u4f60\u7684\u7b14\u8bb0","text":"<p>\u76ee\u6807\uff1a\u4ee5\u540e\u76f4\u63a5\u590d\u5236\u7528</p> <p>\u270d\ufe0f \u505a\u4e00\u4ef6\u4e8b\uff1a</p> <ul> <li>\u641e\u4e00\u4e2a\uff1a<ul> <li><code>note.tex</code></li> <li>\u4ee5\u540e\u6240\u6709\u7b14\u8bb0\u4ece\u5b83\u5f00\u59cb</li> </ul> </li> </ul>"},{"location":"LaTeX/#day-13","title":"\ud83d\udcc5 Day 13\uff1a\u771f\u5b9e\u573a\u666f\u6a21\u62df","text":"<p>\u270d\ufe0f \u6a21\u62df\u4efb\u52a1\uff1a</p> <ul> <li>\u7528 LaTeX \u5199\u4e00\u8282\u4f60\u6b63\u5728\u5b66\u7684\u8bfe\uff08\u5982\u7ebf\u4ee3/\u79bb\u6563\uff09</li> </ul> <p>\ud83c\udfaf \u5b8c\u6574\u3001\u771f\u5b9e\u3001\u4e0d\u8ffd\u6c42\u70ab\u6280</p>"},{"location":"LaTeX/#day-14","title":"\ud83d\udcc5 Day 14\uff1a\u590d\u76d8 &amp; \u56fa\u5316\u6210\u679c \ud83c\udf89","text":"<ul> <li>\u56de\u770b\u8fd9 14 \u5929</li> <li>\u603b\u7ed3\uff1a<ul> <li>\u5e38\u7528 20 \u4e2a\u547d\u4ee4</li> <li>\u5e38\u7528 10 \u4e2a\u73af\u5883</li> </ul> </li> </ul> <p>\ud83d\udd25 \u4f60\u5df2\u7ecf\u5b8c\u5168\u80fd\u81ea\u4e3b\u5199\u6570\u5b66\u7b14\u8bb0\u4e86</p>"},{"location":"LaTeX/#14","title":"\u4e09\u300114 \u5929\u540e\u7684\u201c\u5408\u683c\u6807\u51c6\u201d\uff08\u4f60\u5bf9\u7167\u81ea\u6d4b\uff09","text":"<p>\u5982\u679c\u4f60\u80fd\u505a\u5230\u4e0b\u9762\u8fd9\u4e9b\uff0c\u8bf4\u660e \u76ee\u6807\u8fbe\u6210 \u2705\uff1a</p> <ul> <li>\u2705 \u4e0d\u770b\u6559\u7a0b\u5199\u4e00\u4efd\u6570\u5b66\u7b14\u8bb0</li> <li>\u2705 \u719f\u7ec3\u5199\uff1a<ul> <li>\u5206\u6570 / \u77e9\u9635 / \u6c42\u548c / \u5206\u6bb5\u51fd\u6570</li> </ul> </li> <li>\u2705 \u77e5\u9053\u4e0d\u61c2\u7684\u547d\u4ee4\u600e\u4e48\u67e5</li> <li>\u2705 \u62a5\u9519\u4e0d\u614c\uff0c\u80fd\u5b9a\u4f4d</li> </ul>"},{"location":"LaTeX/#_4","title":"\u56db\u3001\u7ed9\u4f60\u7684\u4e00\u4e2a\u771f\u5fc3\u5efa\u8bae \u2764\ufe0f","text":"<p>LaTeX \u4e0d\u662f\u4e00\u6b21\u6027\u5b66\u4f1a\u7684\uff0c\u800c\u662f\u201c\u7528\u7740\u7528\u7740\u5c31\u4f1a\u4e86\u201d</p> <p>\u4f60\u662f CS + \u559c\u6b22\u6570\u5b66\uff0c\u800c\u4e14\u76ee\u6807\u53ea\u662f \u6392\u7248\u7b14\u8bb0\uff0c \ud83d\udc49 \u4e0d\u9700\u8981\u5b66\u6210 TeX \u5927\u5e08\uff0c\u591f\u7528 + \u987a\u624b = \u5b8c\u7f8e</p> <p>\u5982\u679c\u4f60\u613f\u610f\uff0c\u4e0b\u4e00\u6b65\u6211\u53ef\u4ee5\u5e2e\u4f60\uff1a</p> <ul> <li>\ud83e\udde9 \u505a\u4e00\u4e2a\u4e13\u5c5e\u4f60\u7684\u7b14\u8bb0\u6a21\u677f</li> <li>\ud83d\udcd8 \u628a\u4f60\u67d0\u95e8\u8bfe\u7684\u7b14\u8bb0\u76f4\u63a5\u201cLaTeX \u5316\u201d</li> <li>\ud83e\udde0 \u603b\u7ed3\u4e00\u4efd\u300cLaTeX \u6570\u5b66\u516c\u5f0f\u901f\u67e5\u8868\uff08\u8003\u8bd5\u7ea7\uff09\u300d</li> </ul> <p>\u4f60\u53ef\u4ee5\u76f4\u63a5\u8bf4\uff1a \ud83d\udc49 \u201c\u6309\u8fd9\u4e2a\u8ba1\u5212\u8d70\uff0c\u5148\u5e2e\u6211\u505a\u4e00\u4e2a Day 1 \u7684\u5177\u4f53\u4efb\u52a1\u201d \ud83d\ude0a</p>"},{"location":"Python/","title":"Python","text":"<p>\u57fa\u7840\u8bed\u6cd5\u4e0e\u7b97\u6cd5\u5b9e\u73b0\u3002</p>"},{"location":"%E6%95%B0%E6%8D%AE%E7%BB%93%E6%9E%84/","title":"\u6570\u636e\u7ed3\u6784","text":"<p>\u8fd9\u91cc\u662f\u6570\u636e\u7ed3\u6784\u7b14\u8bb0\u3002</p>"},{"location":"%E6%95%B0%E6%8D%AE%E7%BB%93%E6%9E%84/#bfs","title":"BFS","text":"<p>\u63d0\u793a</p> <p>\u8fd9\u662f\u4e00\u4e2a\u666e\u901a\u63d0\u793a\u3002</p> <p>\u8003\u8bd5\u6613\u9519</p> <p>BFS \u548c DFS \u4e0d\u8981\u6df7\u3002</p> <p>\u91cd\u70b9</p> <p>\u65f6\u95f4\u590d\u6742\u5ea6\u8981\u4f1a\u7b97\u3002</p> \u70b9\u6211\u5c55\u5f00 <p>\u8fd9\u91cc\u653e\u8be6\u7ec6\u63a8\u5bfc / \u8bc1\u660e / \u957f\u89e3\u91ca</p> <pre><code>for(int i = 0; i &lt; n; i++) {\n    printf(\"%d\\n\", i);\n}\nfor(int i = 0; i &lt; n; i++) {\n    sum += a[i];\n}\nqueue&lt;int&gt; q;\n</code></pre>"},{"location":"%E6%95%B0%E6%8D%AE%E7%BB%93%E6%9E%84/#dfs","title":"DFS","text":"<p>\u8003\u8bd5\u6613\u9519</p> <p>BFS \u7528\u961f\u5217\uff0cDFS \u7528\u6808\u6216\u9012\u5f52\u3002</p>"},{"location":"%E7%BA%BF%E6%80%A7%E4%BB%A3%E6%95%B0/","title":"\u7ebf\u6027\u4ee3\u6570","text":"<p>\u884c\u5217\u5f0f\u3001\u77e9\u9635\u3001\u7279\u5f81\u503c\u2026\u2026</p>"},{"location":"%E7%BA%BF%E6%80%A7%E4%BB%A3%E6%95%B0/#_2","title":"\u77e9\u9635\u8868\u793a","text":"\\[ A = \\begin{pmatrix} 1 &amp; 2 \\\\ 3 &amp; 4 \\end{pmatrix}, \\quad x = \\begin{pmatrix} x_1 \\\\ x_2 \\end{pmatrix} \\]"}]}